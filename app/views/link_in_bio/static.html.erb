<%# link_in_bio/static.html.erb %>
<%
  # Extract content variables
  content = @page.content || {}
  background_type = content['backgroundType'] || 'color'
  background_color = content['backgroundColor'] || '#ffffff'
  gradient_start = content['gradientStart'] || '#ffffff'
  gradient_end = content['gradientEnd'] || '#000000'
  gradient_direction = content['gradientDirection'] || 'to right'
  button_color = content['buttonColor'] || '#000000'
  text_color = content['textColor'] || '#000000'
  button_style = content['button'] || 'rounded'
  font_family = content['fontFamily'] || 'rubik'
  social = content['social'] || {}
  profile_image = content['profileImage']
  
  # Generate background style for body
  if background_type == 'gradient'
    body_background = "background: linear-gradient(#{gradient_direction}, #{gradient_start}, #{gradient_end});"
  else
    body_background = "background: #{background_color};"
  end
  
  # Font family mapping
  font_class = case font_family
  when 'rubik' then 'font-rubik'
  when 'mono' then 'font-mono'
  when "'Courier New', monospace" then 'font-courier'
  when "'Brush Script MT', cursive" then 'font-brush'
  else 'font-rubik'
  end
  
  # Button style mapping
  button_class = case button_style
  when 'squared' then 'btn-squared'
  when 'rounded-sm' then 'btn-rounded-sm'
  when 'rounded' then 'btn-rounded'
  when 'rounded-lg' then 'btn-rounded-lg'
  when 'rounded-full' then 'btn-rounded-full'
  else 'btn-rounded'
  end
%>

<% content_for :body_style, body_background %>

<div class="w-full max-w-sm mx-auto">
    <!-- Main Container -->
    <div class="py-8 px-6 overflow-y-auto scrollbar-hidden rounded-3xl min-h-[558px] <%= font_class %>" style="color: <%= text_color %>;">
        
        <!-- Profile Section -->
        <div class="flex items-center flex-col gap-4" style="color: <%= text_color %>;">
            <% if profile_image.present? %>
                <img 
                    class="w-24 h-24 rounded-full object-cover shadow-lg" 
                    src="<%= profile_image %>"
                    alt="<%= @page.title %>"
                    loading="lazy"
                    onerror="this.style.display='none';"
                />
            <% end %>
            <h1 class="text-2xl mb-4 font-bold text-center break-all"><%= @page.title %></h1>
            <% if @page.description.present? %>
                <h2 class="text-base -mt-6 mb-4 text-center break-all"><%= @page.description %></h2>
            <% end %>
        </div>
        
        <!-- Social Links Section (Now appears BEFORE regular links) -->
        <% if social.any? { |k, v| v.present? } %>
            <div class="flex gap-4 mt-6 content-center justify-center">
                <% if social['fb'].present? %>
                    <a 
                        href="<%= social['fb'] %>"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-current hover:scale-105 transition-transform duration-200"
                        title="Facebook"
                        data-social="facebook"
                    >
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                    </a>
                <% end %>
                
                <% if social['ig'].present? %>
                    <a 
                        href="<%= social['ig'] %>"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-current hover:scale-105 transition-transform duration-200"
                        title="Instagram"
                        data-social="instagram"
                    >
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                    </a>
                <% end %>
                
                <% if social['x'].present? %>
                    <a 
                        href="<%= social['x'] %>"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-current hover:scale-105 transition-transform duration-200"
                        title="X (Twitter)"
                        data-social="x"
                    >
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                    </a>
                <% end %>
                
                <% if social['linkedin'].present? %>
                    <a 
                        href="<%= social['linkedin'] %>"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-current hover:scale-105 transition-transform duration-200"
                        title="LinkedIn"
                        data-social="linkedin"
                    >
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                    </a>
                <% end %>
                
                <% if social['tiktok'].present? %>
                    <a 
                        href="<%= social['tiktok'] %>"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-current hover:scale-105 transition-transform duration-200"
                        title="TikTok"
                        data-social="tiktok"
                    >
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg>
                    </a>
                <% end %>
            </div>
        <% end %>
        
        <!-- Links Section (Now appears AFTER social links with reduced margin) -->
        <!-- DEBUG: @links = <%= @links.inspect %> -->
        <% if @links && @links.any? %>
            <div class="mt-5 space-y-4 grid grid-cols-1">
                <% @links.each_with_index do |link, index| %>
                    <a 
                        href="<%= link.url %>"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-block px-4 py-2 font-bold text-center <%= button_class %> hover-scale transition-all duration-200 shadow-md"
                        style="background-color: <%= link.color || '#3b82f6' %>; color: <%= button_color %>;"
                        title="<%= link.description.present? ? link.description : link.title %>"
                        data-link-id="<%= link.id %>"
                    >
                        <%= link.title %>
                    </a>
                <% end %>
            </div>
        <% else %>
            <div class="mt-5 text-center text-sm opacity-60">
                <p>No links added yet</p>
            </div>
        <% end %>
        
        <!-- Footer -->
        <div class="text-center mt-12 opacity-60">
            <p class="text-sm">
                Powered by <a href="https://thin.ly" target="_blank" rel="noopener noreferrer" class="underline hover:no-underline">Thin.ly</a>
            </p>
        </div>
    </div>
</div>

<!-- Analytics Script -->
<% if @tracking_enabled %>
<script>
  (function() {
    const API_BASE = 'https://app.thin.ly';
    const PAGE_CODE = '<%= @page.lookup_code %>';
    
    // Track page view
    fetch(API_BASE + '/api/v1/track/view', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        lookup_code: PAGE_CODE
      })
    }).catch(err => console.error('Tracking error:', err));
    
    // Track link clicks
    document.querySelectorAll('a[data-link-id]').forEach(link => {
      link.addEventListener('click', function(e) {
        const linkId = this.getAttribute('data-link-id');
        
        fetch(API_BASE + '/api/v1/track/click', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            link_id: linkId,
            lookup_code: PAGE_CODE,
            timestamp: new Date().toISOString()
          })
        }).catch(err => console.error('Click tracking error:', err));
      });
    });
    
    // Track social clicks
    document.querySelectorAll('a[data-social]').forEach(link => {
      link.addEventListener('click', function(e) {
        const social = this.getAttribute('data-social');
        
        fetch(API_BASE + '/api/v1/track/social', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            social_platform: social,
            lookup_code: PAGE_CODE,
            timestamp: new Date().toISOString()
          })
        }).catch(err => console.error('Social tracking error:', err));
      });
    });
  })();
</script>
<% end %>

