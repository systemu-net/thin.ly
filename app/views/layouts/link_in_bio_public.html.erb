<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= @page.description || @page.title %>">
    <title><%= @page.title %></title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Font imports -->
    <style>
        @import url("https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700&display=swap");
        
        body {
            font-family: Rubik, sans-serif;
        }
        
        .scrollbar-hidden::-webkit-scrollbar {
            display: none;
        }
        
        .scrollbar-hidden {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        
        /* Custom animations */
        .hover-scale {
            transition: transform 0.2s ease-in-out;
        }
        
        .hover-scale:hover {
            transform: scale(1.05);
        }
        
        /* Font families */
        .font-rubik { font-family: 'Rubik', sans-serif; }
        .font-mono { font-family: 'Courier New', monospace; }
        .font-courier { font-family: 'Courier New', monospace; }
        .font-brush { font-family: 'Brush Script MT', cursive; }
        
        /* Button styles */
        .btn-squared { border-radius: 0; }
        .btn-rounded-sm { border-radius: 0.125rem; }
        .btn-rounded { border-radius: 0.375rem; }
        .btn-rounded-lg { border-radius: 0.5rem; }
        .btn-rounded-full { border-radius: 9999px; }
        
        /* Responsive design */
        @media (max-width: 768px) {
            .container {
                padding: 1rem;
            }
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4" style="<%= yield :body_style %>">
    <%= yield %>
</body>
</html>