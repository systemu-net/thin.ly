# Enhanced-health rules — stop internet-scanner noise from flipping the environment to Degraded/Severe.
#
# Public IPs/hostnames get constant bot probes (/.env, /wp-login.php, /.git/config, host-header
# scans blocked by config.hosts -> 403, ...). Those are answered with 4xx by design, but EB's default
# ApplicationRequests4xx / ELBRequests4xx rules count them against environment health, so a 3-minute
# scanner burst (e.g. 320 requests, ~90% 404) triggers "Ok -> Severe -> Ok" emails with no real fault.
#
# 4xx here is client noise, not an app failure. 5xx, latency, instance and process checks stay enabled,
# so genuine outages still degrade health.
#
# ConfigDocument must be a JSON *string* (not a nested YAML mapping), and only Rules.Environment is a
# valid scope here. Checked with `aws elasticbeanstalk validate-configuration-settings` (an unknown
# scope such as Rules.Instance is rejected, which would fail the whole deploy).
option_settings:
  aws:elasticbeanstalk:healthreporting:system:
    ConfigDocument: |
      {
        "Version": 1,
        "Rules": {
          "Environment": {
            "Application": { "ApplicationRequests4xx": { "Enabled": false } },
            "ELB": { "ELBRequests4xx": { "Enabled": false } }
          }
        }
      }
