# HTTPS :443 listener — pin the DEFAULT cert (thin.ly) + a modern TLS policy, version-controlled.
#
# NOTE: EB's SSLCertificateArns only manages the listener's DEFAULT certificate, NOT SNI certs — a
# second ARN here is silently ignored. So the levelcode.ai cert is attached as an SNI cert directly on
# the ALB 443 listener ("Listener certificates for SNI", EC2 console). If this env is ever fully
# rebuilt, re-add it there (ACM cert 6bf2c463-f51f-4daa-85dc-dbea12f17fad) — or convert this to an
# AWS::ElasticLoadBalancingV2::ListenerCertificate custom resource for a fully in-repo binding.
option_settings:
  aws:elbv2:listener:443:
    ListenerEnabled: 'true'
    Protocol: HTTPS
    DefaultProcess: default
    SSLPolicy: ELBSecurityPolicy-TLS13-1-2-2021-06
    SSLCertificateArns: "arn:aws:acm:us-east-1:555190517386:certificate/02709309-c29b-497a-aaae-9520ee002f10"
