# HTTPS :443 listener certs — serve both brands over one ALB listener via SNI.
#   default cert : thin.ly            (arn .../02709309-...)
#   SNI cert     : levelcode.ai + www (arn .../6bf2c463-...)
# Managed here (not the EB console) so it's version-controlled and survives env rebuilds. The first
# ARN in SSLCertificateArns is the default; the rest are matched per-hostname (SNI).
option_settings:
  aws:elbv2:listener:443:
    ListenerEnabled: 'true'
    Protocol: HTTPS
    DefaultProcess: default
    SSLPolicy: ELBSecurityPolicy-TLS13-1-2-2021-06
    SSLCertificateArns: "arn:aws:acm:us-east-1:555190517386:certificate/02709309-c29b-497a-aaae-9520ee002f10,arn:aws:acm:us-east-1:555190517386:certificate/6bf2c463-f51f-4daa-85dc-dbea12f17fad"
