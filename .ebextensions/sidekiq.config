# .ebextensions/sidekiq.config
#
# This configuration handles Sidekiq log rotation.
# Sidekiq startup is handled by .platform/hooks/
#

commands:
  01_configure_log_rotation:
    command: |
      cat > /etc/logrotate.d/sidekiq << 'EOF'
      /var/app/current/log/sidekiq.log {
        daily
        missingok
        rotate 7
        compress
        delaycompress
        notifempty
        copytruncate
      }
      EOF
    test: "[ ! -f /etc/logrotate.d/sidekiq ]"