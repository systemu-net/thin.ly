[Unit]
Description=Sidekiq Background Job Processor
After=syslog.target network.target

[Service]
Type=simple
WorkingDirectory=/var/app/current
User=webapp
Group=webapp
UMask=0002

# Load environment variables - make it optional
EnvironmentFile=-/opt/elasticbeanstalk/deployment/env

# Start Sidekiq - use simple exec without bash wrapper
ExecStart=/usr/local/bin/bundle exec sidekiq -e production -C config/sidekiq.yml

# Graceful shutdown
TimeoutStopSec=30
KillMode=mixed

# Restart policy
RestartSec=5
Restart=always

# Reduce Ruby memory fragmentation
Environment=MALLOC_ARENA_MAX=2

# Logging
StandardOutput=append:/var/app/current/log/sidekiq.log
StandardError=inherit
SyslogIdentifier=sidekiq

[Install]
WantedBy=multi-user.target
