[Unit]
Description=Sidekiq Background Job Processor
After=syslog.target network.target

[Service]
Type=simple
WorkingDirectory=/var/app/current
User=webapp
Group=webapp
UMask=0002

# Load Elastic Beanstalk environment variables
EnvironmentFile=/opt/elasticbeanstalk/deployment/env

# Start Sidekiq using wrapper script
ExecStart=/var/app/current/.platform/files/start-sidekiq.sh

# Graceful shutdown
TimeoutStopSec=30
KillMode=mixed

# Restart policy
RestartSec=5
Restart=always

# Reduce Ruby memory fragmentation
Environment=MALLOC_ARENA_MAX=2

# Logging
StandardOutput=append:/var/app/current/log/sidekiq.log
StandardError=inherit
SyslogIdentifier=sidekiq

[Install]
WantedBy=multi-user.target
